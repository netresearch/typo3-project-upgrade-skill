//
// The rules the skill-repo-skill validate.yml reusable writes when a
// repository has no markdownlint configuration, so the pre-commit hook and
// CI apply the same rules.
{
  "config": {
    "MD013": false,
    "MD024": false,
    "MD033": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD060": false
  }
}
